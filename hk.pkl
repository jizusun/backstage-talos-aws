amends "package://github.com/jdx/hk/releases/download/v1.46.0/hk@1.46.0#/Config.pkl"

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ["tofu-fmt"] {
        glob = List("*.tf")
        check = "tofu -chdir=terraform fmt -check -recursive"
        fix = "tofu -chdir=terraform fmt -recursive"
      }
      ["tofu-validate"] {
        glob = List("*.tf")
        check = "tofu -chdir=terraform validate"
      }
      ["actionlint"] {
        glob = List(".github/workflows/*.yml")
        check = "actionlint"
      }
      ["opa-test"] {
        glob = List("*.rego")
        check = "opa test policies/opa/"
      }
      ["helm-lint"] {
        glob = List("charts/**/*")
        check = "helm lint charts/backstage/"
      }
      ["gitleaks"] {
        check = "gitleaks detect --source . --no-git -c .gitleaks.toml --redact"
      }
      ["editorconfig"] {
        check = "ec"
      }
      ["zizmor"] {
        glob = List(".github/workflows/*.yml")
        check = "zizmor --min-severity high --min-confidence high .github/workflows/application.yml .github/workflows/infrastructure.yml .github/workflows/pr-validation.yml .github/workflows/policy-check.yml .github/workflows/renovate.yml"
      }
      ["tflint"] {
        glob = List("*.tf")
        check = "tflint --chdir=terraform --recursive --minimum-failure-severity=error"
      }
      ["trivy"] {
        glob = List("*.tf")
        check = "trivy config terraform/ --severity CRITICAL --exit-code 1"
      }
    }
  }
}
