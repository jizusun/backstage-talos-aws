#!/usr/bin/env bun
//MISE description="Apply/destroy tests: tofu test against kumo emulator"
import { $ } from "bun";

console.log("═══ Apply/Destroy Tests (kumo + tofu test) ═══");

console.log("--- Starting kumo ---");
const kumo = Bun.spawn(["kumo"], { stdout: "ignore", stderr: "ignore" });
await Bun.sleep(2000);

try {
  console.log("--- Running tofu test (S3 apply/destroy) ---");
  await $`tofu -chdir=terraform/test/fixtures/s3 test`;
  console.log("\n✅ Apply/destroy tests passed");
} finally {
  kumo.kill();
  console.log("--- kumo stopped ---");
}
